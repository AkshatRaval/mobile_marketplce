{
  "expo": {
    "name": "Go Dealers",
    "slug": "mobile-market-place",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_go.png",
    "scheme": "mobilemarketplace",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godealers.mobilemarketplace",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Go Dealers needs access to your camera to take photos of products for your listings.",
        "NSPhotoLibraryUsageDescription": "Go Dealers needs access to your photo library to select product images for your listings.",
        "NSPhotoLibraryAddUsageDescription": "Go Dealers needs permission to save images to your photo library."
      }
    },
    "android": {
      "package": "com.godealers.mobilemarketplace",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CALL_LOG",
        "WRITE_CALL_LOG",
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "READ_SMS",
        "SEND_SMS"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon_go.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Go Dealers needs access to your photos so you can upload product images to your listings.",
          "cameraPermission": "Go Dealers needs access to your camera so you can take photos of products to sell."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Go Dealers needs camera access to photograph products and scan IMEI barcodes.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb0a7daf-f84b-427a-9ab0-eb41a95cc8fe"
      }
    }
  }
}